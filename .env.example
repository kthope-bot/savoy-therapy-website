# ---- Provided automatically by Railway ----
# DATABASE_URL is injected when you add a MySQL database to the project.
DATABASE_URL=mysql://user:password@host:3306/railway
PORT=3000
NODE_ENV=production

# ---- Generate these yourself ----
# Any long random string. Generate with: openssl rand -hex 32
JWT_SECRET=

# Guards the /contact-report admin page. Generate with: openssl rand -hex 32
# If left blank, /contact-report is denied to everyone (fails closed, by design).
ADMIN_ACCESS_TOKEN=

# ---- Retrieve from your HighLevel account ----
# Without these the site works, but contact forms and PDF downloads
# will NOT reach your CRM.
HIGHLEVEL_API_TOKEN=
HIGHLEVEL_LOCATION_ID=
